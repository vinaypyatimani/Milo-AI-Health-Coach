# Copy to .env and fill in. Never commit .env.
# On Render, set the same values under Environment instead.

# Main model: GPT-6 Luna via the OpenAI API (pay-as-you-go, about 1 cent per check-in)
MILO_MODEL=openai/gpt-6-luna
OPENAI_API_KEY=
# How much Luna thinks before answering: none, low (default), medium, high
# MILO_REASONING_EFFORT=low

# Judge for the evaluation suite: free with a GitHub token (Models: read permission)
JUDGE_MODEL=github/gpt-4o-mini
GITHUB_API_KEY=

# --- Alternatives ---------------------------------------------------------
# Free main model with GitHub (limits: ~150 requests/day, ~8,000 input tokens/request)
# MILO_MODEL=github/gpt-4o-mini

# Free, local (install Ollama and run: ollama pull qwen3:8b)
# MILO_MODEL=ollama/qwen3:8b

# Gemini free tier (check availability in your region)
# MILO_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=

# Claude (paid, pay-as-you-go)
# MILO_MODEL=anthropic/claude-haiku-5-5
# ANTHROPIC_API_KEY=

# --- App settings -----------------------------------------------------------
MILO_TZ=Europe/Berlin
MILO_CORS_ORIGINS=http://localhost:5173
# MILO_DB_PATH=data/milo.db

# --- Demo settings (set these on Render for the presentation) ----------------
# Load the sample plan and tracker files when the database is empty:
# MILO_SEED_DEMO=true
# Pin "today" so the sample week (12-18 Oct) counts as last week.
# Demo only! With a pinned date, plans you build start on the Monday after
# that date, and real workouts you log today may fall outside the plan.
# Remove it when you use Milo for real.
# MILO_TODAY=2026-10-19

# --- How-to videos (optional) ---------------------------------------------------
# Without a key, each exercise links to a YouTube search. With a free YouTube
# Data API key (Google Cloud console > enable "YouTube Data API v3" >
# Credentials > API key) the top video plays inside the app. Results are
# cached, because the free quota allows about 100 searches a day.
# YOUTUBE_API_KEY=

# --- Connect Polar on the Analyze page (optional) --------------------------------
# 1. Log in at https://admin.polaraccesslink.com with a Polar Flow account and create a client.
# 2. Callback URL: <PUBLIC_URL>/api/connect/polar/callback
# 3. Polar's licence: users must agree before their data goes to another service
#    (the app asks), and your privacy policy must say what you do with the data.
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=
# The address people use to open the app, e.g. https://milo-coach.onrender.com
# PUBLIC_URL=
